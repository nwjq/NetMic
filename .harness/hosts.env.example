# NetMic 双机 Harness 本地配置模板
# 复制为 .harness/hosts.env 后填写。
# 连接方式按你的局域网环境填写。

# Coordinator / 本机
NETMIC_HARNESS_COORDINATOR_ROOT=/Users/arc/code/NetMic
NETMIC_HARNESS_MAC_ROOT=/Users/arc/code/NetMic

# Linux Server
NETMIC_HARNESS_LINUX_HOST=
NETMIC_HARNESS_LINUX_PORT=22
NETMIC_HARNESS_LINUX_USER=
# 必须填写远端 NetMic 仓库目录本身，例如 /home/arc/code/NetMic
NETMIC_HARNESS_LINUX_ROOT=
NETMIC_HARNESS_LINUX_PASSWORD=
NETMIC_HARNESS_LINUX_SSH_KEY=

# Client -> Server 默认连接信息
NETMIC_HARNESS_SERVER_HOST=
NETMIC_HARNESS_SERVER_PORT=43000
NETMIC_HARNESS_CLIENT_INPUT_DEVICE=

# 产物与 SSH 行为
NETMIC_HARNESS_ARTIFACT_DIR=.harness/runs
NETMIC_HARNESS_SSH_OPTS=
# 远端 ssh/rsync 单次命令超时（秒）
NETMIC_HARNESS_REMOTE_TIMEOUT_SEC=120
