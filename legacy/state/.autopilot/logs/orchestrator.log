"$(tail -n 20 \"$LOG_DIR/hub.log\" 2>/dev/null || true)\"\n345:    if printf \"%s\" \"$hub_log_tail\" | grep -qiE \"permissionerror|operation not permitted|permission denied\"; then\n346:      add_action \"Agent Hub 启动失败：当前环境可能禁止监听端口（PermissionError）。可在本机终端运行，或改用远端 Hub。日志：$LOG_DIR/hub.log\"\n348:      add_action \"Agent Hub 启动失败，请查看 $LOG_DIR/hub.log\"\n415:  local hub_url=\"$1\"\n416:  if ! hub_health \"$hub_url\"; then\n422:  scripts/seed_tasks.py --hub \"$hub_url\" >>\"$BOOTSTRAP_LOG\" 2>&1 || add_action \"任务种子注入失败：请查看 $BOOTSTRAP_LOG\"\n438:  local hub_url=\"$1\"\n445:  echo \"[$(ts_now)] 启动 autopilot（hub=$hub_url）\" >>\"$BOOTSTRAP_LOG\"\n446:  HUB_URL=\"$hub_url\" scripts/autopilot.sh start >>\"$BOOTSTRAP_LOG\" 2>&1 || add_action \"autopilot 启动失败：请查看 $BOOTSTRAP_LOG\"\n449:summarize_hub_status() {\n450:  local hub_url=\"$1\"\n452:    echo \"hub: unknown（缺少 curl）\"\n456:    echo \"hub: unknown（缺少 python3）\"\n459:  if ! hub_health \"$hub_url\"; then\n460:    echo \"hub: unhealthy ($hub_url)\"\n465:  health_json=\"$(curl -fsS \"$hub_url/v1/health\" 2>/dev/null || true)\"\n466:  agents_json=\"$(curl -fsS \"$hub_url/v1/agents?active_within=900&limit=50\" 2>/dev/null || true)\"\n467:  tasks_json=\"$(curl -fsS \"$hub_url/v1/tasks?limit=50\" 2>/dev/null || true)\"\n486:print(f\"hub: ok agents={len(agents)} tasks={len(tasks)}\")\n516:  local hub_url=\"$2\"\n518:  if [[ \"$role\" == \"hub\" ]]; then\n519:    if hub_health \"$hub_url\"; then\n521:        echo \"hub: running pid=$(cat \"$pid_file\")\"\n523:        echo \"hub: healthy（pid 未知，可能由外部启动）\"\n527:    echo \"hub: not running\"\n539:  local hub_url=\"$1\"\n546:  echo \"hub:    $hub_url\"\n564:  summarize_hub_status \"$hub_url\" || true\n568:  role_pid_line hub \"$hub_url\"\n569:  role_pid_line orchestrator \"$hub_url\"\n570:  role_pid_line builder-linux \"$hub_url\"\n571:  role_pid_line scribe \"$hub_url\"\n585:  resolve_hub_url\n592:    resolve_hub_url\n593:    local hub_url=\"$HUB_URL\"\n595:    start_hub_if_needed 