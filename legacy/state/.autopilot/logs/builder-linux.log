{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"cat <<'RS' > crates/netmic-server/src/main.rs\n//\"'! NetMic 服务端入口（Linux 侧 UDP 接收骨架）。\n//!\n//! 目标对应任务：M1-002-server-udp-receiver\n//!\n//! 当前实现：\n//! 1) 监听 UDP 端口。\n//! 2) 使用 `netmic-proto` 解码 datagram，并分流控制面 / 数据面。\n//! 3) 维护“单客户端占用”的最小行为：忙碌时返回 busy 响应。\n\nuse std::net::{SocketAddr, UdpSocket};\nuse std::time::Duration;\n\nuse anyhow::{Context, Result};\nuse netmic_proto::protocol::{\n    decode_datagram, encode_control_datagram, ControlMessage, Datagram, HandshakeResponse, SessionParams,\n};\nuse tracing::{debug, error, info, warn};\n\nconst DEFAULT_BIND_ADDR: &str = \"0.0.0.0:7788\";\nconst READ_TIMEOUT_MS: u64 = 250;\nconst MAX_DATAGRAM_SIZE: usize = 65_507;\n\nfn main() {\n    if let Err(err) = run() {\n        error!(error = %err, \"netmic-server exited with error\");\n        std::process::exit(1);\n    }\n}\n\nfn run() -> Result<()> {\n    tracing_subscriber::fmt()\n        .with_env_filter(tracing_subscriber::EnvFilter::from_default_env())\n        .init();\n\n    let bind_addr = std::env::var(\"NETMIC_BIND\").unwrap_or_else(|_| DEFAULT_BIND_ADDR.to_string());\n    let socket = UdpSocket::bind(&bind_addr)\n        .with_context(|| format!(\"failed to bind UDP socket at {bind_addr}\"))?;\n    socket\n        .set_read_timeout(Some(Duration::from_millis(READ_TIMEOUT_MS)))\n        .context(\"failed to set UDP read timeout\")?;\n\n    info!(%bind_addr, \"netmic-server UDP receiver listening\");\n\n    let mut active_client: Option<SocketAddr> = None;\n    let mut buf = vec![0_u8; MAX_DATAGRAM_SIZE];\n\n    loop {\n        match socket.recv_from(&mut buf) {\n            Ok((size, addr)) => {\n                let datagram = &buf[..size];\n                handle_datagram(&socket, datagram, addr, &mut active_client);\n            }\n            Err(err)\n                if err.kind() == std::io::ErrorKind::WouldBlock\n                    || err.kind() == std::io::ErrorKind::TimedOut =>\n            {\n                // 读超时是预期行为：让循环保持可中断/可扩展。\n                continue;\n            }\n            Err(err) => return Err(err).context(\"UDP recv_from failed\"),\n        }\n    }\n}\n\nfn handle_datagram(\n    socket: &UdpSocket,\n    datagram: &[u8],\n    addr: SocketAddr,\n    active_client: &mut Option<SocketAddr>,\n) {\n    match decode_datagram(datagram) {\n        Ok(Datagram::Control(message)) => handle_control(socket, message, addr, active_client),\n        Ok(Datagram::Audio(frame)) => handle_audio(frame, addr, active_client),\n        Err(err) => {\n            warn!(peer = %addr, error = %err, \"failed to decode datagram\");\n        }\n    }\n}\n\nfn handle_control(\n    socket: &UdpSocket,\n    message: ControlMessage,\n    addr: SocketAddr,\n    active_client: &mut Option<SocketAddr>,\n) {\n    match message {\n        ControlMessage::HandshakeRequest(request) => {\n            debug!(peer = %addr, client = %request.client_name, \"received handshake request\");\n\n            if let Some(active) = active_client {\n                if *active != addr {\n                    warn!(peer = %addr, active_peer = %active, \"server busy, rejecting new client\");\n                    let response = ControlMessage::HandshakeResponse(HandshakeResponse {\n                        accepted: false,\n                        reason: Some(\"busy\".to_string()),\n                        effective: SessionParams::mvp_default(),\n                        busy: true,\n                    });\n                    if let Err(err) = send_control(socket, addr, &response) {\n                        warn!(peer = %addr, error = %err, \"failed to send busy handshake response\");\n                    }\n                    return;\n                }\n            }\n\n            // 占位实现：直接接受，并将请求参数原样回显（后续接入参数校验/回退）。\n            *active_client = Some(addr);\n            let response = ControlMessage::HandshakeResponse(HandshakeResponse {\n                accepted: true,\n                reason: None,\n                effective: request.requested,\n                busy: false,\n            });\n            if let Err(err) = send_control(socket, addr, &response) {\n                warn!(peer = %addr, error = %err, \"failed to send handshake response\");\n            } else {\n                info!(peer = %addr, \"client accepted as active sender\");\n            }\n        }\n        ControlMessage::Heartbeat(heartbeat) => {\n            if is_active(addr, active_client) {\n                debug!(peer = %addr, seq = heartbeat.seq, \"heartbeat from active client\");\n            } else {\n                warn!(peer = %addr, seq = heartbeat.seq, \"heartbeat from non-active client ignored\");\n            }\n        }\n        ControlMessage::HandshakeResponse(_) => {\n            // 服务端不期望收到握手响应，但记录下来便于排障。\n            warn!(peer = %addr, \"unexpected handshake response received on server\");\n        }\n    }\n}\n\nfn handle_audio(frame: netmic_proto::protocol::AudioFrame, addr: SocketAddr, active_client: &Option<SocketAddr>) {\n    if !is_active(addr, active_client) {\n        warn!(peer = %addr, seq = frame.header.seq, \"audio from non-active client ignored\");\n        return;\n    }\n\n    // 占位行为：仅记录关键头字段，后续接入 jitter buffer 与音频注入。\n    debug!(\n        peer = %addr,\n        seq = frame.header.seq,\n        rate = frame.header.sample_rate_hz,\n        channels = frame.header.channels,\n        samples_per_channel = frame.header.samples_per_channel,\n        \"received audio frame\"\n    );\n}\n\nfn send_control(socket: &UdpSocket, addr: SocketAddr, message: &ControlMessage) -> Result<()> {\n    let datagram = encode_control_datagram(message)?;\n    socket\n        .send_to(&datagram, addr)\n        .with_context(|| format!(\"failed to send control message to {addr}\"))?;\n    Ok(())\n}\n\nfn is_active(addr: SocketAddr, active_client: &Option<SocketAddr>) -> bool {\n    matches!(active_client, Some(active) if *active == addr)\n}\nRS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"cat <<'RS' > crates/netmic-server/src/main.rs\n//\"'! NetMic 服务端入口（Linux 侧 UDP 接收骨架）。\n//!\n//! 目标对应任务：M1-002-server-udp-receiver\n//!\n//! 当前实现：\n//! 1) 监听 UDP 端口。\n//! 2) 使用 `netmic-proto` 解码 datagram，并分流控制面 / 数据面。\n//! 3) 维护“单客户端占用”的最小行为：忙碌时返回 busy 响应。\n\nuse std::net::{SocketAddr, UdpSocket};\nuse std::time::Duration;\n\nuse anyhow::{Context, Result};\nuse netmic_proto::protocol::{\n    decode_datagram, encode_control_datagram, ControlMessage, Datagram, HandshakeResponse, SessionParams,\n};\nuse tracing::{debug, error, info, warn};\n\nconst DEFAULT_BIND_ADDR: &str = \"0.0.0.0:7788\";\nconst READ_TIMEOUT_MS: u64 = 250;\nconst MAX_DATAGRAM_SIZE: usize = 65_507;\n\nfn main() {\n    if let Err(err) = run() {\n        error!(error = %err, \"netmic-server exited with error\");\n        std::process::exit(1);\n    }\n}\n\nfn run() -> Result<()> {\n    tracing_subscriber::fmt()\n        .with_env_filter(tracing_subscriber::EnvFilter::from_default_env())\n        .init();\n\n    let bind_addr = std::env::var(\"NETMIC_BIND\").unwrap_or_else(|_| DEFAULT_BIND_ADDR.to_string());\n    let socket = UdpSocket::bind(&bind_addr)\n        .with_context(|| format!(\"failed to bind UDP socket at {bind_addr}\"))?;\n    socket\n        .set_read_timeout(Some(Duration::from_millis(READ_TIMEOUT_MS)))\n        .context(\"failed to set UDP read timeout\")?;\n\n    info!(%bind_addr, \"netmic-server UDP receiver listening\");\n\n    let mut active_client: Option<SocketAddr> = None;\n    let mut buf = vec![0_u8; MAX_DATAGRAM_SIZE];\n\n    loop {\n        match socket.recv_from(&mut buf) {\n            Ok((size, addr)) => {\n                let datagram = &buf[..size];\n                handle_datagram(&socket, datagram, addr, &mut active_client);\n            }\n            Err(err)\n                if err.kind() == std::io::ErrorKind::WouldBlock\n                    || err.kind() == std::io::ErrorKind::TimedOut =>\n            {\n                // 读超时是预期行为：让循环保持可中断/可扩展。\n                continue;\n            }\n            Err(err) => return Err(err).context(\"UDP recv_from failed\"),\n        }\n    }\n}\n\nfn handle_datagram(\n    socket: &UdpSocket,\n    datagram: &[u8],\n    addr: SocketAddr,\n    active_client: &mut Option<SocketAddr>,\n) {\n    match decode_datagram(datagram) {\n        Ok(Datagram::Control(message)) => handle_control(socket, message, addr, active_client),\n        Ok(Datagram::Audio(frame)) => handle_audio(frame, addr, active_client),\n        Err(err) => {\n            warn!(peer = %addr, error = %err, \"failed to decode datagram\");\n        }\n    }\n}\n\nfn handle_control(\n    socket: &UdpSocket,\n    message: ControlMessage,\n    addr: SocketAddr,\n    active_client: &mut Option<SocketAddr>,\n) {\n    match message {\n        ControlMessage::HandshakeRequest(request) => {\n            debug!(peer = %addr, client = %request.client_name, \"received handshake request\");\n\n            if let Some(active) = active_client {\n                if *active != addr {\n                    warn!(peer = %addr, active_peer = %active, \"server busy, rejecting new client\");\n                    let response = ControlMessage::HandshakeResponse(HandshakeResponse {\n                        accepted: false,\n                        reason: Some(\"busy\".to_string()),\n                        effective: SessionParams::mvp_default(),\n                        busy: true,\n                    });\n                    if let Err(err) = send_control(socket, addr, &response) {\n                        warn!(peer = %addr, error = %err, \"failed to send busy handshake response\");\n                    }\n                    return;\n                }\n            }\n\n            // 占位实现：直接接受，并将请求参数原样回显（后续接入参数校验/回退）。\n            *active_client = Some(addr);\n            let response = ControlMessage::HandshakeResponse(HandshakeResponse {\n                accepted: true,\n                reason: None,\n                effective: request.requested,\n                busy: false,\n            });\n            if let Err(err) = send_control(socket, addr, &response) {\n                warn!(peer = %addr, error = %err, \"failed to send handshake response\");\n            } else {\n                info!(peer = %addr, \"client accepted as active sender\");\n            }\n        }\n        ControlMessage::Heartbeat(heartbeat) => {\n            if is_active(addr, active_client) {\n                debug!(peer = %addr, seq = heartbeat.seq, \"heartbeat from active client\");\n            } else {\n                warn!(peer = %addr, seq = heartbeat.seq, \"heartbeat from non-active client ignored\");\n            }\n        }\n        ControlMessage::HandshakeResponse(_) => {\n            // 服务端不期望收到握手响应，但记录下来便于排障。\n            warn!(peer = %addr, \"unexpected handshake response received on server\");\n        }\n    }\n}\n\nfn handle_audio(frame: netmic_proto::protocol::AudioFrame, addr: SocketAddr, active_client: &Option<SocketAddr>) {\n    if !is_active(addr, active_client) {\n        warn!(peer = %addr, seq = frame.header.seq, \"audio from non-active client ignored\");\n        return;\n    }\n\n    // 占位行为：仅记录关键头字段，后续接入 jitter buffer 与音频注入。\n    debug!(\n        peer = %addr,\n        seq = frame.header.seq,\n        rate = frame.header.sample_rate_hz,\n        channels = frame.header.channels,\n        samples_per_channel = frame.header.samples_per_channel,\n        \"received audio frame\"\n    );\n}\n\nfn send_control(socket: &UdpSocket, addr: SocketAddr, message: &ControlMessage) -> Result<()> {\n    let datagram = encode_control_datagram(message)?;\n    socket\n        .send_to(&datagram, addr)\n        .with_context(|| format!(\"failed to send control message to {addr}\"))?;\n    Ok(())\n}\n\nfn is_active(addr: SocketAddr, active_client: &Option<SocketAddr>) -> bool {\n    matches!(active_client, Some(active) if *active == addr)\n}\nRS'","aggregated_output":"","exit_code":0,"status":"completed"}}
