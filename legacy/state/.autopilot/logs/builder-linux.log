{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"cat <<'RS' > crates/netmic-proto/src/protocol.rs\n//\"'! 最小协议骨架（握手/心跳/统计占位 + UDP datagram 区分控制面/数据面）。\n//!\n//! 设计目标：\n//! 1) 与 `MVP.md` 第 5 节保持一致：UDP + 控制/数据分流。\n//! 2) 给 server/client 提供稳定的最小解码入口，便于后续逐步替换实现。\n\nuse serde::{Deserialize, Serialize};\nuse thiserror::Error;\n\n/// 协议版本（datagram 头字段）。\npub const PROTOCOL_VERSION: u8 = 1;\n\n/// UDP datagram 的消息类型。\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n#[repr(u8)]\npub enum DatagramKind {\n    Control = 1,\n    AudioPcm16 = 2,\n}\n\nimpl DatagramKind {\n    pub fn from_u8(value: u8) -> Option<Self> {\n        match value {\n            1 => Some(Self::Control),\n            2 => Some(Self::AudioPcm16),\n            _ => None,\n        }\n    }\n}\n\n/// datagram 解码后的结构。\n#[derive(Debug, Clone, PartialEq)]\npub enum Datagram {\n    Control(ControlMessage),\n    Audio(AudioFrame),\n}\n\n/// 协议错误（最小可观测）。\n#[derive(Debug, Error)]\npub enum ProtocolError {\n    #[error(\"datagram too short: need at least {needed} bytes, got {actual}\")]\n    DatagramTooShort { needed: usize, actual: usize },\n    #[error(\"unsupported protocol version: expected {expected}, got {actual}\")]\n    UnsupportedVersion { expected: u8, actual: u8 },\n    #[error(\"unknown datagram kind: {0}\")]\n    UnknownKind(u8),\n    #[error(\"invalid control payload json: {0}\")]\n    InvalidControlJson(String),\n    #[error(\"invalid audio payload: {0}\")]\n    InvalidAudioPayload(&'\"'static str),\n}\n\n/// 客户端请求的会话参数（后续由参数校验模块收敛）。\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\npub struct SessionParams {\n    pub codec: String,\n    pub sample_rate_hz: u32,\n    pub channels: u16,\n    pub chunk_ms: u32,\n    pub opus_bitrate_kbps: Option<u32>,\n    pub jitter_buffer_ms: u32,\n}\n\nimpl SessionParams {\n    /// 生成一个与文档默认值一致的参数集（字符串先占位）。\n    pub fn mvp_default() -> Self {\n        Self {\n            codec: \\\"opus\\\".to_string(),\n            sample_rate_hz: 48_000,\n            channels: 1,\n            chunk_ms: 20,\n            opus_bitrate_kbps: Some(48),\n            jitter_buffer_ms: 100,\n        }\n    }\n}\n\n/// 握手请求。\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\npub struct HandshakeRequest {\n    pub client_name: String,\n    pub requested: SessionParams,\n    pub token: Option<String>,\n}\n\n/// 握手响应。\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\npub struct HandshakeResponse {\n    pub accepted: bool,\n    pub reason: Option<String>,\n    pub effective: SessionParams,\n    pub busy: bool,\n}\n\n/// 心跳报文。\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\npub struct Heartbeat {\n    pub session_id: String,\n    pub seq: u64,\n    pub sent_at_ms: u64,\n}\n\n/// 控制面消息（先用 JSON 承载，便于调试与演进）。\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(tag = \\\"type\\\", content = \\\"data\\\")]\npub enum ControlMessage {\n    HandshakeRequest(HandshakeRequest),\n    HandshakeResponse(HandshakeResponse),\n    Heartbeat(Heartbeat),\n}\n\n/// 音频帧头（PCM16）。\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\npub struct AudioFrameHeader {\n    /// 单调递增的序号（用于丢包与乱序观测）。\n    pub seq: u64,\n    /// 当前帧声明的采样率（MVP 期望为 48k）。\n    pub sample_rate_hz: u32,\n    /// 声道数（MVP 固定为 1）。\n    pub channels: u16,\n    /// 每声道采样数（例如 20ms@48k=960）。\n    pub samples_per_channel: u16,\n}\n\n/// PCM16 音频帧。\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct AudioFrame {\n    pub header: AudioFrameHeader,\n    /// 线性 PCM16 采样数据（按声道交错）。\n    pub samples: Vec<i16>,\n}\n\nimpl AudioFrame {\n    pub fn expected_sample_count(&self) -> usize {\n        usize::from(self.header.channels) * usize::from(self.header.samples_per_channel)\n    }\n}\n\n/// datagram 固定头长度：kind(1) + version(1)\npub const DATAGRAM_HEADER_LEN: usize = 2;\n/// audio 负载头长度：seq(8) + rate(4) + channels(2) + samples_per_channel(2)\npub const AUDIO_HEADER_LEN: usize = 8 + 4 + 2 + 2;\n\n/// 将控制消息编码为 datagram。\npub fn encode_control_datagram(message: &ControlMessage) -> Result<Vec<u8>, ProtocolError> {\n    let payload = serde_json::to_vec(message)\n        .map_err(|err| ProtocolError::InvalidControlJson(err.to_string()))?;\n    let mut buf = Vec::with_capacity(DATAGRAM_HEADER_LEN + payload.len());\n    buf.push(DatagramKind::Control as u8);\n    buf.push(PROTOCOL_VERSION);\n    buf.extend_from_slice(&payload);\n    Ok(buf)\n}\n\n/// 将 PCM16 音频帧编码为 datagram（最小二进制头）。\npub fn encode_audio_datagram(frame: &AudioFrame) -> Result<Vec<u8>, ProtocolError> {\n    let expected = frame.expected_sample_count();\n    if frame.samples.len() \"'!= expected {\n        return Err(ProtocolError::InvalidAudioPayload(\n            \"sample length does not match header\",\n        ));\n    }\n\n    let mut buf = Vec::with_capacity(DATAGRAM_HEADER_LEN + AUDIO_HEADER_LEN + expected * 2);\n    buf.push(DatagramKind::AudioPcm16 as u8);\n    buf.push(PROTOCOL_VERSION);\n    buf.extend_from_slice(&frame.header.seq.to_le_bytes());\n    buf.extend_from_slice(&frame.header.sample_rate_hz.to_le_bytes());\n    buf.extend_from_slice(&frame.header.channels.to_le_bytes());\n    buf.extend_from_slice(&frame.header.samples_per_channel.to_le_bytes());\n    for sample in &frame.samples {\n        buf.extend_from_slice(&sample.to_le_bytes());\n    }\n    Ok(buf)\n}\n\n/// 从 datagram 解码为控制/音频消息。\npub fn decode_datagram(datagram: &[u8]) -> Result<Datagram, ProtocolError> {\n    if datagram.len() < DATAGRAM_HEADER_LEN {\n        return Err(ProtocolError::DatagramTooShort {\n            needed: DATAGRAM_HEADER_LEN,\n            actual: datagram.len(),\n        });\n    }\n\n    let kind_raw = datagram[0];\n    let version = datagram[1];\n    if version != PROTOCOL_VERSION {\n        return Err(ProtocolError::UnsupportedVersion {\n            expected: PROTOCOL_VERSION,\n            actual: version,\n        });\n    }\n    let payload = &datagram[DATAGRAM_HEADER_LEN..];\n\n    let kind = DatagramKind::from_u8(kind_raw).ok_or(ProtocolError::UnknownKind(kind_raw))?;\n    match kind {\n        DatagramKind::Control => decode_control_payload(payload).map(Datagram::Control),\n        DatagramKind::AudioPcm16 => decode_audio_payload(payload).map(Datagram::Audio),\n    }\n}\n\nfn decode_control_payload(payload: &[u8]) -> Result<ControlMessage, ProtocolError> {\n    serde_json::from_slice(payload).map_err(|err| ProtocolError::InvalidControlJson(err.to_string()))\n}\n\nfn decode_audio_payload(payload: &[u8]) -> Result<AudioFrame, ProtocolError> {\n    if payload.len() < AUDIO_HEADER_LEN {\n        return Err(ProtocolError::DatagramTooShort {\n            needed: AUDIO_HEADER_LEN,\n            actual: payload.len(),\n        });\n    }\n\n    let seq = read_u64_le(&payload[0..8]);\n    let sample_rate_hz = read_u32_le(&payload[8..12]);\n    let channels = read_u16_le(&payload[12..14]);\n    let samples_per_channel = read_u16_le(&payload[14..16]);\n\n    if channels == 0 {\n        return Err(ProtocolError::InvalidAudioPayload(\"channels must be > 0\"));\n    }\n    if samples_per_channel == 0 {\n        return Err(ProtocolError::InvalidAudioPayload(\n            \"samples_per_channel must be > 0\",\n        ));\n    }\n\n    let sample_count = usize::from(channels) * usize::from(samples_per_channel);\n    let sample_bytes_needed = sample_count\n        .checked_mul(2)\n        .ok_or(ProtocolError::InvalidAudioPayload(\"sample count overflow\"))?;\n    let data = &payload[AUDIO_HEADER_LEN..];\n    if data.len() != sample_bytes_needed {\n        return Err(ProtocolError::InvalidAudioPayload(\n            \"sample bytes length does not match header\",\n        ));\n    }\n\n    let mut samples = Vec::with_capacity(sample_count);\n    for chunk in data.chunks_exact(2) {\n        samples.push(i16::from_le_bytes([chunk[0], chunk[1]]));\n    }\n\n    Ok(AudioFrame {\n        header: AudioFrameHeader {\n            seq,\n            sample_rate_hz,\n            channels,\n            samples_per_channel,\n        },\n        samples,\n    })\n}\n\nfn read_u16_le(bytes: &[u8]) -> u16 {\n    u16::from_le_bytes([bytes[0], bytes[1]])\n}\n\nfn read_u32_le(bytes: &[u8]) -> u32 {\n    u32::from_le_bytes([bytes[0], bytes[1], bytes[2], bytes[3]])\n}\n\nfn read_u64_le(bytes: &[u8]) -> u64 {\n    u64::from_le_bytes([\n        bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7],\n    ])\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn control_roundtrip_json() {\n        let msg = ControlMessage::Heartbeat(Heartbeat {\n            session_id: \"s\".to_string(),\n            seq: 7,\n            sent_at_ms: 42,\n        });\n        let datagram = encode_control_datagram(&msg).expect(\"encode control\");\n        let decoded = decode_datagram(&datagram).expect(\"decode control\");\n        assert_eq!(decoded, Datagram::Control(msg));\n    }\n\n    #[test]\n    fn audio_roundtrip_binary() {\n        let frame = AudioFrame {\n            header: AudioFrameHeader {\n                seq: 1,\n                sample_rate_hz: 48_000,\n                channels: 1,\n                samples_per_channel: 4,\n            },\n            samples: vec![1, -2, 3, -4],\n        };\n        let datagram = encode_audio_datagram(&frame).expect(\"encode audio\");\n        let decoded = decode_datagram(&datagram).expect(\"decode audio\");\n        assert_eq!(decoded, Datagram::Audio(frame));\n    }\n\n    #[test]\n    fn audio_rejects_mismatched_length() {\n        let frame = AudioFrame {\n            header: AudioFrameHeader {\n                seq: 1,\n                sample_rate_hz: 48_000,\n                channels: 1,\n                samples_per_channel: 4,\n            },\n            samples: vec![1, 2],\n        };\n        let err = encode_audio_datagram(&frame).expect_err(\"should fail\");\n        matches!(err, ProtocolError::InvalidAudioPayload(_));\n    }\n}\nRS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"cat <<'RS' > crates/netmic-proto/src/protocol.rs\n//\"'! 最小协议骨架（握手/心跳/统计占位 + UDP datagram 区分控制面/数据面）。\n//!\n//! 设计目标：\n//! 1) 与 `MVP.md` 第 5 节保持一致：UDP + 控制/数据分流。\n//! 2) 给 server/client 提供稳定的最小解码入口，便于后续逐步替换实现。\n\nuse serde::{Deserialize, Serialize};\nuse thiserror::Error;\n\n/// 协议版本（datagram 头字段）。\npub const PROTOCOL_VERSION: u8 = 1;\n\n/// UDP datagram 的消息类型。\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n#[repr(u8)]\npub enum DatagramKind {\n    Control = 1,\n    AudioPcm16 = 2,\n}\n\nimpl DatagramKind {\n    pub fn from_u8(value: u8) -> Option<Self> {\n        match value {\n            1 => Some(Self::Control),\n            2 => Some(Self::AudioPcm16),\n            _ => None,\n        }\n    }\n}\n\n/// datagram 解码后的结构。\n#[derive(Debug, Clone, PartialEq)]\npub enum Datagram {\n    Control(ControlMessage),\n    Audio(AudioFrame),\n}\n\n/// 协议错误（最小可观测）。\n#[derive(Debug, Error)]\npub enum ProtocolError {\n    #[error(\"datagram too short: need at least {needed} bytes, got {actual}\")]\n    DatagramTooShort { needed: usize, actual: usize },\n    #[error(\"unsupported protocol version: expected {expected}, got {actual}\")]\n    UnsupportedVersion { expected: u8, actual: u8 },\n    #[error(\"unknown datagram kind: {0}\")]\n    UnknownKind(u8),\n    #[error(\"invalid control payload json: {0}\")]\n    InvalidControlJson(String),\n    #[error(\"invalid audio payload: {0}\")]\n    InvalidAudioPayload(&'\"'static str),\n}\n\n/// 客户端请求的会话参数（后续由参数校验模块收敛）。\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\npub struct SessionParams {\n    pub codec: String,\n    pub sample_rate_hz: u32,\n    pub channels: u16,\n    pub chunk_ms: u32,\n    pub opus_bitrate_kbps: Option<u32>,\n    pub jitter_buffer_ms: u32,\n}\n\nimpl SessionParams {\n    /// 生成一个与文档默认值一致的参数集（字符串先占位）。\n    pub fn mvp_default() -> Self {\n        Self {\n            codec: \\\"opus\\\".to_string(),\n            sample_rate_hz: 48_000,\n            channels: 1,\n            chunk_ms: 20,\n            opus_bitrate_kbps: Some(48),\n            jitter_buffer_ms: 100,\n        }\n    }\n}\n\n/// 握手请求。\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\npub struct HandshakeRequest {\n    pub client_name: String,\n    pub requested: SessionParams,\n    pub token: Option<String>,\n}\n\n/// 握手响应。\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\npub struct HandshakeResponse {\n    pub accepted: bool,\n    pub reason: Option<String>,\n    pub effective: SessionParams,\n    pub busy: bool,\n}\n\n/// 心跳报文。\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\npub struct Heartbeat {\n    pub session_id: String,\n    pub seq: u64,\n    pub sent_at_ms: u64,\n}\n\n/// 控制面消息（先用 JSON 承载，便于调试与演进）。\n#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(tag = \\\"type\\\", content = \\\"data\\\")]\npub enum ControlMessage {\n    HandshakeRequest(HandshakeRequest),\n    HandshakeResponse(HandshakeResponse),\n    Heartbeat(Heartbeat),\n}\n\n/// 音频帧头（PCM16）。\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\npub struct AudioFrameHeader {\n    /// 单调递增的序号（用于丢包与乱序观测）。\n    pub seq: u64,\n    /// 当前帧声明的采样率（MVP 期望为 48k）。\n    pub sample_rate_hz: u32,\n    /// 声道数（MVP 固定为 1）。\n    pub channels: u16,\n    /// 每声道采样数（例如 20ms@48k=960）。\n    pub samples_per_channel: u16,\n}\n\n/// PCM16 音频帧。\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct AudioFrame {\n    pub header: AudioFrameHeader,\n    /// 线性 PCM16 采样数据（按声道交错）。\n    pub samples: Vec<i16>,\n}\n\nimpl AudioFrame {\n    pub fn expected_sample_count(&self) -> usize {\n        usize::from(self.header.channels) * usize::from(self.header.samples_per_channel)\n    }\n}\n\n/// datagram 固定头长度：kind(1) + version(1)\npub const DATAGRAM_HEADER_LEN: usize = 2;\n/// audio 负载头长度：seq(8) + rate(4) + channels(2) + samples_per_channel(2)\npub const AUDIO_HEADER_LEN: usize = 8 + 4 + 2 + 2;\n\n/// 将控制消息编码为 datagram。\npub fn encode_control_datagram(message: &ControlMessage) -> Result<Vec<u8>, ProtocolError> {\n    let payload = serde_json::to_vec(message)\n        .map_err(|err| ProtocolError::InvalidControlJson(err.to_string()))?;\n    let mut buf = Vec::with_capacity(DATAGRAM_HEADER_LEN + payload.len());\n    buf.push(DatagramKind::Control as u8);\n    buf.push(PROTOCOL_VERSION);\n    buf.extend_from_slice(&payload);\n    Ok(buf)\n}\n\n/// 将 PCM16 音频帧编码为 datagram（最小二进制头）。\npub fn encode_audio_datagram(frame: &AudioFrame) -> Result<Vec<u8>, ProtocolError> {\n    let expected = frame.expected_sample_count();\n    if frame.samples.len() \"'!= expected {\n        return Err(ProtocolError::InvalidAudioPayload(\n            \"sample length does not match header\",\n        ));\n    }\n\n    let mut buf = Vec::with_capacity(DATAGRAM_HEADER_LEN + AUDIO_HEADER_LEN + expected * 2);\n    buf.push(DatagramKind::AudioPcm16 as u8);\n    buf.push(PROTOCOL_VERSION);\n    buf.extend_from_slice(&frame.header.seq.to_le_bytes());\n    buf.extend_from_slice(&frame.header.sample_rate_hz.to_le_bytes());\n    buf.extend_from_slice(&frame.header.channels.to_le_bytes());\n    buf.extend_from_slice(&frame.header.samples_per_channel.to_le_bytes());\n    for sample in &frame.samples {\n        buf.extend_from_slice(&sample.to_le_bytes());\n    }\n    Ok(buf)\n}\n\n/// 从 datagram 解码为控制/音频消息。\npub fn decode_datagram(datagram: &[u8]) -> Result<Datagram, ProtocolError> {\n    if datagram.len() < DATAGRAM_HEADER_LEN {\n        return Err(ProtocolError::DatagramTooShort {\n            needed: DATAGRAM_HEADER_LEN,\n            actual: datagram.len(),\n        });\n    }\n\n    let kind_raw = datagram[0];\n    let version = datagram[1];\n    if version != PROTOCOL_VERSION {\n        return Err(ProtocolError::UnsupportedVersion {\n            expected: PROTOCOL_VERSION,\n            actual: version,\n        });\n    }\n    let payload = &datagram[DATAGRAM_HEADER_LEN..];\n\n    let kind = DatagramKind::from_u8(kind_raw).ok_or(ProtocolError::UnknownKind(kind_raw))?;\n    match kind {\n        DatagramKind::Control => decode_control_payload(payload).map(Datagram::Control),\n        DatagramKind::AudioPcm16 => decode_audio_payload(payload).map(Datagram::Audio),\n    }\n}\n\nfn decode_control_payload(payload: &[u8]) -> Result<ControlMessage, ProtocolError> {\n    serde_json::from_slice(payload).map_err(|err| ProtocolError::InvalidControlJson(err.to_string()))\n}\n\nfn decode_audio_payload(payload: &[u8]) -> Result<AudioFrame, ProtocolError> {\n    if payload.len() < AUDIO_HEADER_LEN {\n        return Err(ProtocolError::DatagramTooShort {\n            needed: AUDIO_HEADER_LEN,\n            actual: payload.len(),\n        });\n    }\n\n    let seq = read_u64_le(&payload[0..8]);\n    let sample_rate_hz = read_u32_le(&payload[8..12]);\n    let channels = read_u16_le(&payload[12..14]);\n    let samples_per_channel = read_u16_le(&payload[14..16]);\n\n    if channels == 0 {\n        return Err(ProtocolError::InvalidAudioPayload(\"channels must be > 0\"));\n    }\n    if samples_per_channel == 0 {\n        return Err(ProtocolError::InvalidAudioPayload(\n            \"samples_per_channel must be > 0\",\n        ));\n    }\n\n    let sample_count = usize::from(channels) * usize::from(samples_per_channel);\n    let sample_bytes_needed = sample_count\n        .checked_mul(2)\n        .ok_or(ProtocolError::InvalidAudioPayload(\"sample count overflow\"))?;\n    let data = &payload[AUDIO_HEADER_LEN..];\n    if data.len() != sample_bytes_needed {\n        return Err(ProtocolError::InvalidAudioPayload(\n            \"sample bytes length does not match header\",\n        ));\n    }\n\n    let mut samples = Vec::with_capacity(sample_count);\n    for chunk in data.chunks_exact(2) {\n        samples.push(i16::from_le_bytes([chunk[0], chunk[1]]));\n    }\n\n    Ok(AudioFrame {\n        header: AudioFrameHeader {\n            seq,\n            sample_rate_hz,\n            channels,\n            samples_per_channel,\n        },\n        samples,\n    })\n}\n\nfn read_u16_le(bytes: &[u8]) -> u16 {\n    u16::from_le_bytes([bytes[0], bytes[1]])\n}\n\nfn read_u32_le(bytes: &[u8]) -> u32 {\n    u32::from_le_bytes([bytes[0], bytes[1], bytes[2], bytes[3]])\n}\n\nfn read_u64_le(bytes: &[u8]) -> u64 {\n    u64::from_le_bytes([\n        bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7],\n    ])\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn control_roundtrip_json() {\n        let msg = ControlMessage::Heartbeat(Heartbeat {\n            session_id: \"s\".to_string(),\n            seq: 7,\n            sent_at_ms: 42,\n        });\n        let datagram = encode_control_datagram(&msg).expect(\"encode control\");\n        let decoded = decode_datagram(&datagram).expect(\"decode control\");\n        assert_eq!(decoded, Datagram::Control(msg));\n    }\n\n    #[test]\n    fn audio_roundtrip_binary() {\n        let frame = AudioFrame {\n            header: AudioFrameHeader {\n                seq: 1,\n                sample_rate_hz: 48_000,\n                channels: 1,\n                samples_per_channel: 4,\n            },\n            samples: vec![1, -2, 3, -4],\n        };\n        let datagram = encode_audio_datagram(&frame).expect(\"encode audio\");\n        let decoded = decode_datagram(&datagram).expect(\"decode audio\");\n        assert_eq!(decoded, Datagram::Audio(frame));\n    }\n\n    #[test]\n    fn audio_rejects_mismatched_length() {\n        let frame = AudioFrame {\n            header: AudioFrameHeader {\n                seq: 1,\n                sample_rate_hz: 48_000,\n                channels: 1,\n                samples_per_channel: 4,\n            },\n            samples: vec![1, 2],\n        };\n        let err = encode_audio_datagram(&frame).expect_err(\"should fail\");\n        matches!(err, ProtocolError::InvalidAudioPayload(_));\n    }\n}\nRS'","aggregated_output":"","exit_code":0,"status":"completed"}}
