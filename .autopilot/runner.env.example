# NetMic 自动驾驶本机/跨机配置示例（建议复制为 .autopilot/runner.env）
# 说明：agent_bootstrap.sh 会自动 source .autopilot/runner.env

# Hub 地址（可选）。不填则自动探测本机 IP 并使用 7788 端口。
# HUB_URL=http://192.168.11.10:7788

# 若需要自动拉起 mac builder，请配置 SSH（可选）。
# BUILDER_MAC_SSH=user@mac-runner-host
# BUILDER_MAC_ROOT=/path/to/NetMic

# 监督器刷新间隔（秒）。
# BOOTSTRAP_REFRESH_SECONDS=15

# 是否允许监督器自动安装 Rust 工具链（默认 1=开启）。
# 自动安装会通过 rustup 官方脚本写入 $HOME/.cargo，并尝试 source $HOME/.cargo/env。
# 如需关闭自动安装，可显式设置为 0。
# NETMIC_AUTO_INSTALL_RUST=0

# rustup profile（可选，默认 minimal）。
# NETMIC_RUSTUP_PROFILE=minimal
